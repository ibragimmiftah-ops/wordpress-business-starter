{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "color": {
      "palette": [
        {"slug": "ink", "name": "Ink", "color": "#111827"},
        {"slug": "paper", "name": "Paper", "color": "#ffffff"},
        {"slug": "muted", "name": "Muted", "color": "#667085"},
        {"slug": "surface", "name": "Surface", "color": "#f5f7fa"},
        {"slug": "brand", "name": "Brand", "color": "#1d4ed8"}
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {"slug": "system", "name": "System", "fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif"}
      ],
      "fontSizes": [
        {"slug": "small", "size": "0.875rem", "name": "Small"},
        {"slug": "medium", "size": "1rem", "name": "Medium"},
        {"slug": "large", "size": "1.25rem", "name": "Large"},
        {"slug": "x-large", "size": "clamp(2rem, 5vw, 4.5rem)", "name": "Display"}
      ]
    }
  },
  "styles": {
    "color": {"text": "var:preset|color|ink", "background": "var:preset|color|paper"},
    "typography": {"fontFamily": "var:preset|font-family|system", "lineHeight": "1.6"},
    "elements": {
      "heading": {"typography": {"lineHeight": "1.1"}},
      "link": {"color": {"text": "var:preset|color|brand"}}
    }
  }
}
